# ===========================================
# TACOS Technologies - Environment Variables
# ===========================================

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://tacostechnologies.com

# ===========================================
# Analytics & Tracking
# ===========================================

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console Verification
GOOGLE_SITE_VERIFICATION=your-verification-code

# ===========================================
# Email Configuration (Contact Form)
# ===========================================

# Resend API (Edge-compatible, recommended for Cloudflare Pages)
# Sign up at https://resend.com and get your API key
RESEND_API_KEY=re_xxxxxxxxxx
RESEND_FROM_EMAIL=noreply@tacostechnologies.com

# Note: You'll need to verify your domain in Resend dashboard
# or use onboarding@resend.dev for testing

# ===========================================
# Deployment (Optional)
# ===========================================

# Cloudflare (if deploying to Cloudflare Pages)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Vercel (auto-configured if using Vercel)
# VERCEL_URL is automatically set

# ===========================================
# Social Media (Optional)
# ===========================================

# Instagram Access Token (for feed integration)
# INSTAGRAM_ACCESS_TOKEN=

# ===========================================
# Security (Production)
# ===========================================

# Rate limiting secret
# RATE_LIMIT_SECRET=

# reCAPTCHA (for form protection)
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
