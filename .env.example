# ===========================================
# TACOS Technologies - Environment Variables
# ===========================================

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://tacostechnologies.com

# ===========================================
# Analytics & Tracking
# ===========================================

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console Verification
GOOGLE_SITE_VERIFICATION=your-verification-code

# ===========================================
# Email Configuration (Contact Form)
# ===========================================

# SMTP Settings (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Alternative: SendGrid
# SENDGRID_API_KEY=your-sendgrid-api-key

# ===========================================
# Deployment (Optional)
# ===========================================

# Cloudflare (if deploying to Cloudflare Pages)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Vercel (auto-configured if using Vercel)
# VERCEL_URL is automatically set

# ===========================================
# Social Media (Optional)
# ===========================================

# Instagram Access Token (for feed integration)
# INSTAGRAM_ACCESS_TOKEN=

# ===========================================
# Security (Production)
# ===========================================

# Rate limiting secret
# RATE_LIMIT_SECRET=

# reCAPTCHA (for form protection)
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
